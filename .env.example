APP_NAME="Talibon Intra-Office Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=talibon_portal
DB_USERNAME=postgres
DB_PASSWORD=
DB_TIMEZONE=Asia/Manila

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
DOCUMENT_MAX_UPLOAD_MB=15
DOCUMENT_MAX_FILES_PER_OPERATION=5

# Required for a known prototype login password. Production demo seeding requires a private 16+ character value.
PROTOTYPE_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
